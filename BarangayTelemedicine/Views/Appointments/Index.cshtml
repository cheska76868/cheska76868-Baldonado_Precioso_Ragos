@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Appointments";

    // Helper function to map status to Bootstrap colors
    string GetStatusClass(string status) => status switch
    {
        "Pending" => "warning text-dark",
        "Confirmed" => "primary",
        "Completed" => "success",
        "Cancelled" => "danger",
        _ => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold">
        <i class="bi bi-calendar-check me-2 text-success"></i>Appointments
    </h5>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Appointment
    </a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 flex-wrap align-items-center">
            <select name="status" class="form-select form-select-sm" style="max-width:150px;">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>

            <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" style="max-width:160px;" />
            
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Patient</th>
                    <th>Health Worker</th>
                    <th>Date & Time</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No appointments found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Id</td>
                            <td>@a.Patient?.FullName</td>
                            <td>@a.HealthWorker?.FullName</td>
                            <td>@a.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")</td>
                            <td>@a.Reason</td>
                            <td>
                                <span class="badge bg-@GetStatusClass(a.Status) px-2 py-1">
                                    @a.Status
                                </span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>