@* Views/Appointments/Create.cshtml *@
@model Appointment
@{
    ViewData["Title"] = "Schedule Appointment";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-plus me-2 text-success"></i>Schedule Appointment</h5>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="card" style="max-width:680px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.85rem;"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PatientId" class="form-label fw-semibold">Patient</label>
                    <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select">
                        <option value="">-- Select Patient --</option>
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HealthWorkerId" class="form-label fw-semibold">Health Worker</label>
                    <select asp-for="HealthWorkerId" asp-items="ViewBag.HealthWorkers" class="form-select">
                        <option value="">-- Select Health Worker --</option>
                    </select>
                    <span asp-validation-for="HealthWorkerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AppointmentDate" class="form-label fw-semibold"></label>
                    <input asp-for="AppointmentDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Reason" class="form-label fw-semibold"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Chief complaint or reason for visit..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Additional notes (optional)"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Schedule</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
