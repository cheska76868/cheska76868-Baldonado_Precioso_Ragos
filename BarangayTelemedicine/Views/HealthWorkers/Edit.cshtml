@model HealthWorker
@{
    ViewData["Title"] = "Edit Health Worker";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Health Worker</h5>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.85rem;"></div>
            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="FirstName" class="form-label fw-semibold"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="LastName" class="form-label fw-semibold"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Position" class="form-label fw-semibold"></label>
                    <select asp-for="Position" class="form-select">
                        <option>Barangay Health Worker</option>
                        <option>Nurse</option>
                        <option>Midwife</option>
                        <option>Doctor</option>
                        <option>Sanitary Inspector</option>
                    </select>
                    <span asp-validation-for="Position" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedBarangay" class="form-label fw-semibold"></label>
                    <input asp-for="AssignedBarangay" class="form-control" />
                    <span asp-validation-for="AssignedBarangay" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="ContactNumber" class="form-label fw-semibold"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DateHired" class="form-label fw-semibold"></label>
                    <input asp-for="DateHired" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
