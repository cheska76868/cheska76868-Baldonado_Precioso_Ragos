@model HealthWorker
@{
    ViewData["Title"] = "Health Worker Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2 text-info"></i>@Model.FullName</h5>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="card" style="max-width:500px;">
    <div class="card-body">
        <dl class="row" style="font-size:0.875rem;">
            <dt class="col-sm-5 text-secondary">Full Name</dt>
            <dd class="col-sm-7"><strong>@Model.FullName</strong></dd>
            <dt class="col-sm-5 text-secondary">Position</dt>
            <dd class="col-sm-7">@Model.Position</dd>
            <dt class="col-sm-5 text-secondary">Assigned Barangay</dt>
            <dd class="col-sm-7">@Model.AssignedBarangay</dd>
            <dt class="col-sm-5 text-secondary">Contact Number</dt>
            <dd class="col-sm-7">@(Model.ContactNumber ?? "-")</dd>
            <dt class="col-sm-5 text-secondary">Email</dt>
            <dd class="col-sm-7">@(Model.Email ?? "-")</dd>
            <dt class="col-sm-5 text-secondary">Date Hired</dt>
            <dd class="col-sm-7">@Model.DateHired.ToString("MMMM dd, yyyy")</dd>
            <dt class="col-sm-5 text-secondary">Status</dt>
            <dd class="col-sm-7">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>
