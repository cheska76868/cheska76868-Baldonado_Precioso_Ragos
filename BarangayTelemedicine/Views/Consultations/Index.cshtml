@* Views/Consultations/Index.cshtml *@
@model IEnumerable<Consultation>
@{
    ViewData["Title"] = "Consultations";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-file-medical me-2 text-purple"></i>Consultations</h5>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>New Consultation</a>
</div>
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search patient..." style="max-width:200px;" />
            <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" style="max-width:160px;" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Patient</th><th>Health Worker</th><th>Date</th><th>Diagnosis</th><th>Type</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No consultations found.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Patient?.FullName</td>
                        <td>@c.HealthWorker?.FullName</td>
                        <td>@c.ConsultationDate.ToString("MMM dd, yyyy")</td>
                        <td>@c.Diagnosis</td>
                        <td>
                            @if (c.IsTelemedicine)
                            {
                                <span class="badge bg-info text-dark">📡 Telemedicine</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">In-Person</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
