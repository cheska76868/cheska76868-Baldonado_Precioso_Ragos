@* ============================================================ *@
@* Views/Patients/Index.cshtml *@
@* ============================================================ *@
@model IEnumerable<Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Patients</h5>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Register Patient
    </a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search by name..." style="max-width:200px;" />
            <input type="text" name="barangay" value="@ViewBag.Barangay" class="form-control form-control-sm" placeholder="Filter by barangay..." style="max-width:200px;" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Age</th>
                    <th>Gender</th>
                    <th>Barangay</th>
                    <th>Contact</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No patients found.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td><strong>@p.FullName</strong></td>
                        <td>@p.Age yrs</td>
                        <td>@p.Gender</td>
                        <td>@p.Barangay</td>
                        <td>@(p.ContactNumber ?? "-")</td>
                        <td>@p.RegisteredOn.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-xs btn-outline-info btn-sm"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-xs btn-outline-warning btn-sm"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-xs btn-outline-danger btn-sm"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
