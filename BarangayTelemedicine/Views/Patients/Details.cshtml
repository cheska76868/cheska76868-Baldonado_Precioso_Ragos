@model Patient
@{
    ViewData["Title"] = "Patient Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2 text-info"></i>@Model.FullName</h5>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header py-2"><i class="bi bi-info-circle me-2"></i>Personal Info</div>
            <div class="card-body">
                <dl class="row mb-0" style="font-size:0.875rem;">
                    <dt class="col-sm-5 text-secondary">Full Name</dt>
                    <dd class="col-sm-7">@Model.FullName</dd>
                    <dt class="col-sm-5 text-secondary">Age</dt>
                    <dd class="col-sm-7">@Model.Age years old</dd>
                    <dt class="col-sm-5 text-secondary">Gender</dt>
                    <dd class="col-sm-7">@Model.Gender</dd>
                    <dt class="col-sm-5 text-secondary">Date of Birth</dt>
                    <dd class="col-sm-7">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</dd>
                    <dt class="col-sm-5 text-secondary">Barangay</dt>
                    <dd class="col-sm-7">@Model.Barangay</dd>
                    <dt class="col-sm-5 text-secondary">Address</dt>
                    <dd class="col-sm-7">@(Model.Address ?? "-")</dd>
                    <dt class="col-sm-5 text-secondary">Contact</dt>
                    <dd class="col-sm-7">@(Model.ContactNumber ?? "-")</dd>
                    <dt class="col-sm-5 text-secondary">Email</dt>
                    <dd class="col-sm-7">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-5 text-secondary">Medical Notes</dt>
                    <dd class="col-sm-7">@(Model.MedicalNotes ?? "None")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header py-2"><i class="bi bi-calendar me-2"></i>Appointment History</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Health Worker</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (Model.Appointments == null || !Model.Appointments.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No appointments.</td></tr>
                        }
                        @foreach (var a in Model.Appointments ?? new List<Appointment>())
                        {
                            <tr>
                                <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                <td>@a.HealthWorker?.FullName</td>
                                <td><span class="badge badge-@a.Status.ToLower()">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header py-2"><i class="bi bi-file-medical me-2"></i>Consultation Records</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Diagnosis</th><th>Type</th></tr></thead>
                    <tbody>
                        @if (Model.Consultations == null || !Model.Consultations.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No consultations.</td></tr>
                        }
                        @foreach (var c in Model.Consultations ?? new List<Consultation>())
                        {
                            <tr>
                                <td>@c.ConsultationDate.ToString("MMM dd, yyyy")</td>
                                <td>@c.Diagnosis</td>
                                <td>@c.TelemedicineLabel</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
