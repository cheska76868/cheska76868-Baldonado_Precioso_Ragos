@model IEnumerable<Medicine>
@{
    ViewData["Title"] = "Medicines";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-capsule me-2 text-primary"></i>Medicine Inventory</h5>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Add Medicine</a>
</div>
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search medicine..." style="max-width:200px;" />
            <select name="category" class="form-select form-select-sm" style="max-width:160px;">
                <option value="">All Categories</option>
                @foreach (var cat in ViewBag.Categories ?? new List<string>())
                {
                    <option selected="@(ViewBag.Category == cat)">@cat</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Medicine Name</th><th>Generic Name</th><th>Category</th><th>Dosage</th><th>Stock</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No medicines found.</td></tr>
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td><strong>@m.Name</strong></td>
                        <td>@m.GenericName</td>
                        <td>@m.Category</td>
                        <td>@(m.Dosage ?? "-")</td>
                        <td>@m.StockQuantity @m.Unit</td>
                        <td>
                            @{
                                var badgeClass = m.StockStatus switch
                                {
                                    "Out of Stock" => "bg-danger",
                                    "Low Stock" => "bg-warning text-dark",
                                    _ => "bg-success"
                                };
                            }
                            <span class="badge @badgeClass">@m.StockStatus</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
